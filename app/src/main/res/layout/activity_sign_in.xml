<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="#844"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignIn">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" ❇️ Sign In ❇️"
        android:padding="12dp"
        android:textSize="38sp"
        android:background="@drawable/shape"
        android:textAlignment="center"
        android:textStyle="bold|italic"
        android:textColor="#0347F4"/>

<!--    below is a card view-->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFF"
            android:padding="10dp">

            <!--Below is the email edit text-->
            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="#F6C8C8"
                android:hint=" ✉️Enter Email address"
                android:padding="11dp"
                android:textColor="#000"
                android:textColorHint="#000" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="#F6C8C8"
                android:hint=" 🔑Enter Your Password"
                android:padding="11dp"
                android:textColor="#000"
                android:textColorHint="#000"/>

            <Button
                android:id="@+id/signinBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="50dp"
                android:backgroundTint="#051232"
                android:padding="10dp"
                android:text="👮 Signin"
                android:textColor="#E1CDD8"
                android:textSize="25sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/signup_text"
                android:textAlignment="center"
                android:textSize="23sp"
                android:layout_marginTop="25dp"
                android:textColor="#0035D4"
                android:id="@+id/signuptxt" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>


</LinearLayout>